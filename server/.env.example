# String de conexão MySQL completa (Prisma CLI só lê .env, não .env.local)
DATABASE_URL="mysql://user:password@host:3306/webtools"

# Gere um valor aleatório longo por ambiente (assinatura dos JWTs de acesso)
SESSION_SECRET="troque-por-um-valor-aleatorio-longo"

# Credenciais do OAuth Client criado no Google Cloud Console
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Precisa bater exatamente com o registrado no Google Cloud Console
GOOGLE_REDIRECT_URI="https://api.tiagosmagno.com.br/auth/google/callback"

# Origem do site público (usada em CORS e no redirect pós-login web)
FRONTEND_URL="https://tiagosmagno.com.br"

# Scheme customizado que o app Electron registra pra capturar o callback do OAuth
ELECTRON_CALLBACK_SCHEME="webtools"

PORT=3333
